# ============================================================
#  ZYNEX STUDIO — Environment Variables
#  Copy this file to .env.local and fill in your Supabase keys
#     cp .env.example .env.local
# ============================================================

# --- Supabase (Project Settings → API) ----------------------

# Public URL of your Supabase project. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. Safe for the browser — protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-SIDE ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------

# Canonical URL, used for SEO metadata, sitemap and Open Graph.
# On Vercel this can be left blank (VERCEL_URL is used as fallback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number for checkout (international format, no + sign).
# Can also be changed at runtime from Admin → Landing CMS.
NEXT_PUBLIC_WHATSAPP_NUMBER=6285141308100

# --- Seeding (optional, local only) -------------------------

# Running `npm run seed` with this set promotes the matching
# registered account to the admin role.
# SEED_ADMIN_EMAIL=you@email.com
